# Netlify Environment Variables
# Copy this to .env and fill in your values, then add each to Netlify dashboard:
# Site settings > Environment variables

# Contact form - Elastic Email (required for contact form to work)
ELASTIC_EMAIL_API_KEY=your_elastic_email_api_key_here
ELASTIC_EMAIL_FROM_EMAIL=your_verified_sender_email@domain.com

# Public contact info (shown on portfolio)
CONTACT_EMAIL=farazkiqbal.work@gmail.com
# CONTACT_PHONE=+91 XXXX XXXXXX  # Uncomment if you want phone displayed

# Optional: Analytics (add your GA4 Measurement ID if desired)
# GA_MEASUREMENT_ID=G-XXXXXXXXXX